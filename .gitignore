kaggle_outputs*/**/*.pth
kaggle_outputs*/**/*.npz
kaggle_outputs*/**/*.zip
kaggle_outputs*/outputs_full/report/
kaggle_outputs*/outputs_full/submission/

# The earlier run is only compared by its results (report Section 6.6).
kaggle_outputs_run1/*
!kaggle_outputs_run1/outputs_full/
kaggle_outputs_run1/outputs_full/*
!kaggle_outputs_run1/outputs_full/results/
!kaggle_outputs_run1/outputs_full/meta.json

