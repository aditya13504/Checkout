kaggle_outputs*/**/*.npz
kaggle_outputs*/**/*.zip
kaggle_outputs*/outputs_full/report/
kaggle_outputs*/outputs_full/submission/

# The hand-in archive is rebuilt by report/build_submission.py.
submission/*.zip

